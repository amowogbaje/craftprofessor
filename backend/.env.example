APP_NAME="Craft Professor"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=
FRONTEND_URL=

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=



LC_ALL=en_US.UTF-8
LANG=en_US.UTF-8


p
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379



MAIL_MAILER=smtp
MAIL_HOST=smtp.googlemail.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=""

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"



PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=
PINTEREST_REDIRECT_URI=${APP_URL}/api/social/pinterest/callback
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_ENVIRONMENT=production # options: "production" or "sandbox"
SOCIAL_MAX_BOARDS_PER_PIN=1


GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.0-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_LOCATION=us-central1
VEO_MODEL=veo-3.0-generate-001
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=${APP_URL}/api/auth/google/callback


FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=
META_GRAPH_API_VERSION=v21.0

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202601
LINKEDIN_REDIRECT_URI=

# JWT auth
JWT_ALGO=HS256
JWT_TTL=10080               # access token lifetime, minutes (default: 7 days)
JWT_RESET_TTL=10            # password-reset token lifetime, minutes
JWT_SECRET=


# Flutterwave (coin purchases)
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
FLUTTERWAVE_SECRET_HASH=  # set the same value as "verif-hash" in your Flutterwave dashboard webhook config
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3
p
# SMS OTP (Termii — swap provider in OtpService::sendSms() if you prefer another)
TERMII_API_KEY=
TERMII_SENDER_ID=

# Coin economy (all optional, these are the defaults)
COIN_SIGNUP_BONUS=50
COIN_COST_IMAGE_PROMPT=2
COIN_COST_IMAGE_GENERATION=10
COIN_COST_VIDEO_PROMPT=3
COIN_COST_VIDEO_GENERATION=40
COIN_COST_CHARACTER_PORTRAIT=8
COIN_COST_NARRATION_AUDIO=3


# OTHER IMAGE PROVIDERS (optional, you can add more if you want)
IMAGE_PROVIDER=cloudflare # default / cloudflare / together / agnes
# Together API (https://together.xyz/)
TOGETHER_API_KEY=

# Cloudflare API (https://developers.cloudflare.com/images/)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# VIDEO PROVIDER (optional — defaults to Veo/Vertex AI, see GOOGLE_CLOUD_* above)
VIDEO_PROVIDER=veo # veo / agnes

# Agnes AI (https://agnes-ai.com) — free tier, image+video, image-reference
# capable. Same key is used for both IMAGE_PROVIDER=agnes and
# VIDEO_PROVIDER=agnes. Treat this as a third-party, low-trust credential:
# scope/rotate it independently of anything else. Leave IMAGE_PROVIDER and
# VIDEO_PROVIDER on their current values until you've verified this in
# staging — flipping either one back is a one-line env change.
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_IMAGE_MODEL=agnes-image-2.1-flash
AGNES_VIDEO_MODEL=agnes-video-v2.0

# NARRATION TEXT-TO-SPEECH (optional, defaults to gemini — free tier,
# reuses GEMINI_API_KEY above, no new key needed unless you switch providers)
TTS_PROVIDER=gemini # gemini / openai / eleven
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore

# OpenAI TTS — only needed if TTS_PROVIDER=openai
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# ElevenLabs (https://elevenlabs.io) — only needed if TTS_PROVIDER=eleven
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
ELEVENLABS_MODEL=eleven_multilingual_v2


STORYVERSE_READER_BASE_URL=https://storyverse.amowogbaje.com
STORYVERSE_BASE_URL=https://storyverseapi.amowogbaje.com
